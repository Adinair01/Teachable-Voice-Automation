# Copy to .env and fill in. NEVER commit .env.
PORT=3000
MONGO_URL=mongodb://mongo:27017/tva
DEEPGRAM_API_KEY=
GROQ_API_KEY=
# Primary model, then the ladder tried when it is rate limited, down, decommissioned or answers unusably.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
LOG_LEVEL=info
