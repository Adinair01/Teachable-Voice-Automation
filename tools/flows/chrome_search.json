{
  "intentKey": "search_google",
  "description": "search Google for a term in Chrome",
  "appPackage": "com.android.chrome",
  "steps": [
    {
      "type": "launch",
      "selector": {},
      "slotRef": null,
      "value": "com.android.chrome",
      "sensitive": false,
      "expect": {}
    },
    {
      "type": "type",
      "selector": {
        "className": "android.widget.EditText"
      },
      "slotRef": "query",
      "value": "{{query}}",
      "sensitive": false,
      "expect": {}
    },
    {
      "type": "tap",
      "selector": {
        "text": "{{query}} near me"
      },
      "slotRef": "query",
      "value": "",
      "sensitive": false,
      "expect": {
        "package": "com.android.chrome"
      }
    }
  ]
}